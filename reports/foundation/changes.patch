+  async update(actor, id, input) {
+    this.authorize(actor, true); const data = parse(payload, input);
+    if (data.title !== undefined) data.title = data.title.replace(/\0/g, '') || 'Untitled';
+    if (data.systemInstructions !== undefined) data.systemInstructions = data.systemInstructions.replace(/\0/g, '');
+    const row = await this.repository.update(actor.workspaceId, id, data);
+    if (!row) throw new AppError('NOT_FOUND', 'Conversation not found.', 404); return row;
+  }
+  async delete(actor, id) {
+    this.authorize(actor, true);
+    if (!await this.repository.delete(actor.workspaceId, id)) throw new AppError('NOT_FOUND', 'Conversation not found.', 404);
+    return { ok: true };
+  }
