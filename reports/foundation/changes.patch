+  assert.ok(!source.includes("if(false&&p==='/api/workflows'"));
+  assert.ok(!source.includes('workflow.completed')); assert.ok(source.includes('WORKFLOWS_REMOVED'));
+  assert.ok(source.includes('workflows:[]'));
+});
