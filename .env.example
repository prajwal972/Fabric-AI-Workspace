# Core — generate secrets; never commit real values
NODE_ENV=development
FABRIC_MASTER_KEY=replace-with-at-least-32-random-characters
FABRIC_HOST=127.0.0.1
FABRIC_PORT=8787
FABRIC_PUBLIC_URL=http://127.0.0.1:8787
FABRIC_DATA_DIR=./data
FABRIC_METRICS_TOKEN=replace-with-a-random-monitoring-token
LOG_LEVEL=info
FABRIC_SHUTDOWN_TIMEOUT_MS=30000

# Production data services
DATABASE_URL=
FABRIC_DB_POOL_MAX=10
PGSSLMODE=require
REDIS_URL=
FABRIC_REDIS_COMMAND_TIMEOUT_MS=5000
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=fabric
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256

# Upload security and workers
FABRIC_UPLOAD_SCAN_MODE=required
FABRIC_CLAMDSCAN_BIN=clamdscan
FABRIC_MALWARE_SCAN_TIMEOUT_MS=60000
FABRIC_WORKER_CONCURRENCY=4
FABRIC_JOB_TIMEOUT_MS=300000
FABRIC_JOB_LOCK_MS=30000

# Providers and research
FABRIC_OLLAMA_URL=http://127.0.0.1:11434
FABRIC_RESEARCH_URL=
FABRIC_STT_URL=

# Azure Voice — credentials stay server-side
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
FABRIC_VOICE_DEFAULT_LOCALE=en-IN
FABRIC_VOICE_AUTO_DETECT=1

# OAuth connectors
FABRIC_OAUTH_GITHUB_CLIENT_ID=
FABRIC_OAUTH_GITHUB_CLIENT_SECRET=
FABRIC_OAUTH_SLACK_CLIENT_ID=
FABRIC_OAUTH_SLACK_CLIENT_SECRET=
FABRIC_OAUTH_GOOGLE_CLIENT_ID=
FABRIC_OAUTH_GOOGLE_CLIENT_SECRET=
FABRIC_OAUTH_MICROSOFT_CLIENT_ID=
FABRIC_OAUTH_MICROSOFT_CLIENT_SECRET=
FABRIC_OAUTH_NOTION_CLIENT_ID=
FABRIC_OAUTH_NOTION_CLIENT_SECRET=

# Native runtime integrity — required before installation in production
FABRIC_NATIVE_RUNTIME_SHA256=
FABRIC_NATIVE_MODEL_SHA256=
FABRIC_NATIVE_VOICE_RUNTIME_SHA256=
FABRIC_NATIVE_VOICE_MODEL_SHA256=
FABRIC_NATIVE_MAX_RUNTIME_BYTES=1500000000
FABRIC_NATIVE_MAX_MODEL_BYTES=10000000000

# Foundation checkpoint test-only configuration (use a disposable test database)
# Dedicated disposable services are required for integration tests; never target production.
FABRIC_TEST_DATABASE_URL=
# Optional installed Chromium executable; otherwise run npx playwright install chromium.
FABRIC_TEST_CHROMIUM=

# Gateway and execution budgets
MAX_AGENT_STEPS=8
MAX_TOOL_EXECUTION_TIME=30000
MAX_TOTAL_RUNTIME=120000
FABRIC_MODEL_PRICING_JSON={}
FABRIC_EMBEDDING_PROVIDER_ID=
# Model must return exactly 768 dimensions. Configure per-provider embeddingModel in Settings.

# Isolated execution: use a dedicated executor host, never the API host's Docker socket.
FABRIC_SANDBOX_IMAGE=
FABRIC_SANDBOX_DEDICATED_HOST=0
FABRIC_SANDBOX_DOCKER_HOST=
FABRIC_CONTAINER_BIN=docker
FABRIC_ANALYTICS_DATABASE_URL=
FABRIC_ANALYTICS_WORKSPACE_ID=

# Transactional notifications
FABRIC_SMTP_URL=
FABRIC_EMAIL_FROM=

# Compose deployment: URLs must use application, not bootstrap/superuser roles.
FABRIC_MIGRATION_DATABASE_URL=
POSTGRES_IMAGE=
REDIS_IMAGE=
CLAMAV_IMAGE=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
FABRIC_VERSION=

# Operator-reviewed private provider origins (comma separated). Workspace admins cannot widen this allowlist.
FABRIC_TRUSTED_MODEL_ORIGINS=

# PostgreSQL public-use safeguards (production/staging defaults shown)
# These do not apply to the preserved local JSON demo runtime.
FABRIC_REGISTRATION_MODE=closed
FABRIC_ALLOW_CLOUD_AI=false
FABRIC_REQUIRE_EMAIL_VERIFICATION=true
FABRIC_AI_USER_DAILY_REQUESTS=25
FABRIC_AI_WORKSPACE_DAILY_REQUESTS=100
FABRIC_AI_MAX_OUTPUT_TOKENS=4096

# Dedicated Python executor Docker transport: authenticated remote TLS only.
# Certificates stay private on the executor-facing host; never commit them.
DOCKER_TLS_VERIFY=1
DOCKER_CERT_PATH=

# Cosine-distance cutoff for scoped semantic memory, 0..2. Calibrate with your embedding model.
FABRIC_MEMORY_MAX_DISTANCE=0.35
