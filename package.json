{
  "name": "fabric-ai-workspace",
  "version": "1.10.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node src/start.mjs",
    "dev": "node --watch src/start.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "native:plan": "node scripts/install-native.mjs --plan",
    "native:install": "node scripts/install-native.mjs --data-dir ./data",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:security": "npm audit --audit-level=high && node --test test/core.test.mjs test/rbac.test.mjs test/http-hardening.test.mjs test/native-integrity.test.mjs test/json-store.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:rollback": "node scripts/migrate.mjs --rollback",
    "ci": "npm run check && npm test && npm run test:coverage && npm audit --audit-level=high",
    "test:postgres": "node --test integration/postgres.integration.mjs",
    "test:browser": "playwright test --config playwright.config.mjs",
    "worker": "node src/workers/production.mjs",
    "test:runtime": "node --test integration/runtime.integration.mjs",
    "test:evaluation": "node --test test/evaluation.test.mjs",
    "test:browser:runtime": "playwright test --config playwright.runtime.config.mjs",
    "test:import": "node --test integration/import.integration.mjs",
    "db:import": "node scripts/import-legacy.mjs",
    "evaluate:live": "node scripts/evaluate-live.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:sandbox:sql": "node --test integration/sql-sandbox.integration.mjs",
    "test:redis:failure": "node --test integration/redis-failure.integration.mjs",
    "test:backup:restore": "node --test integration/backup-restore.integration.mjs",
    "test:ai-policy": "node --test integration/ai-policy.integration.mjs",
    "test:worker:health": "node --test integration/worker-heartbeat.integration.mjs",
    "benchmark:analyst": "node scripts/benchmark-analyst.mjs",
    "test:storage": "node --test integration/storage.integration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "argon2": "0.44.0",
    "bullmq": "5.81.5",
    "exceljs": "4.4.0",
    "file-type": "21.3.4",
    "ioredis": "5.8.1",
    "nodemailer": "10.0.16",
    "pg": "8.16.3",
    "pino": "9.9.4",
    "prom-client": "15.1.3",
    "undici": "7.30.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
