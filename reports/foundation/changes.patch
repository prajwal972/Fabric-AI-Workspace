+import fs from 'node:fs/promises';
+import path from 'node:path';
+import crypto from 'node:crypto';
+
+const LEDGER = 'CREATE TABLE IF NOT EXISTS schema_migrations (version text PRIMARY KEY, checksum text NOT NULL, applied_at timestamptz NOT NULL DEFAULT now())';
+const LOCK = 7_413_321;
+
+// Preserve existing on-disk SQL/checksums. The runner, not a migration file,
+// owns the transaction so DDL and ledger updates commit or roll back together.
+function migrationBody(sql) {
+  return sql.replace(/^\s*BEGIN\s*;/i, '').replace(/COMMIT\s*;\s*$/i, '');
+}
+
+export async function runMigrations({ pool, directory, rollback = false, onApplied = () => {} }) {
+  const client = await pool.connect();
+  let locked = false;
+  const changed = [];
+  try {
+    await client.query('SELECT pg_advisory_lock($1)', [LOCK]);
+    locked = true;
+    await client.query(LEDGER);
+    const files = (await fs.readdir(directory))
+      .filter(name => /^\d+_.+\.sql$/.test(name) && !name.endsWith('.down.sql')).sort();
+    const applied = new Map((await client.query('SELECT version, checksum FROM schema_migrations')).rows.map(row => [row.version, row.checksum]));
+    const targets = rollback ? [...applied.keys()].sort().slice(-1) : files;
+    for (const version of targets) {
+      if (!/^\d+_[\w.-]+\.sql$/.test(version)) throw new Error('Invalid migration version');
+      const original = await fs.readFile(path.join(directory, version), 'utf8');
+      const checksum = crypto.createHash('sha256').update(original).digest('hex');
+      if (applied.has(version) && applied.get(version) !== checksum)
+        throw new Error(`Applied migration checksum changed: ${version}`);
+      if (!rollback && applied.has(version)) continue;
+      const sql = rollback ? await fs.readFile(path.join(directory, version.replace(/\.sql$/, '.down.sql')), 'utf8') : original;
+      await client.query('BEGIN');
+      try {
+        await client.query(migrationBody(sql));
+        if (rollback) {
+          // The historic initial down script drops the ledger itself.
+          await client.query(LEDGER);
+          await client.query('DELETE FROM schema_migrations WHERE version = $1', [version]);
+        } else {
+          await client.query('INSERT INTO schema_migrations(version, checksum) VALUES ($1, $2)', [version, checksum]);
+        }
+        await client.query('COMMIT');
+      } catch (error) {
+        await client.query('ROLLBACK').catch(() => {});
+        throw error;
+      }
+      changed.push(version);
+      onApplied(version, rollback);
+    }
+    return changed;
+  } finally {
+    if (locked) await client.query('SELECT pg_advisory_unlock($1)', [LOCK]).catch(() => {});
+    client.release();
+  }
+}
